# ==============================================================================
# RiskWise 2.0 — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure local values.
# Do NOT commit actual secrets or credentials to version control.
# Production secrets should be sourced from AWS Secrets Manager.
# ==============================================================================

# Application
APP_ENV=development
LOG_LEVEL=info

# Frontend (web)
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000

# Backend (api)
DATABASE_URL=sqlite:///./riskwise_local.db
REDIS_URL=

# AWS Infrastructure (S3, KMS, Secrets Manager)
AWS_REGION=ap-southeast-2
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Google Gemini API Foundation (Primary & Authoritative LLM Provider)
GEMINI_API_KEY=<set-in-aws-secrets-manager-or-local-env>
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
#GEMINI_TIMEOUT_SECONDS=30.0
#GEMINI_MAX_RETRIES=3
#GEMINI_MAX_OUTPUT_TOKENS=4096

# External Integrations (Placeholders)
GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
AISSTREAM_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
MAPBOX_ACCESS_TOKEN=
PROJECT44_CLIENT_ID=
PROJECT44_CLIENT_SECRET=
MOBILITY_DATABASE_ACCESS_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
KARRIO_API_KEY=
SLACK_BOT_TOKEN=

# Google OAuth 2.0 (Server-side Placeholders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_PROJECT_ID=
