# ==============================================================================
# RiskWise 2.0 — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure local values.
# Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# Application
APP_ENV=development
LOG_LEVEL=info

# Frontend (web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend (api)
DATABASE_URL=
REDIS_URL=

# AWS Infrastructure
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon Bedrock
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
LLM_PROVIDER=bedrock

# External Integrations (Placeholders)
GOOGLE_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
OPENWEATHER_API_KEY=
MAPBOX_ACCESS_TOKEN=
PROJECT44_CLIENT_ID=
PROJECT44_CLIENT_SECRET=
AISSTREAM_API_KEY=
SLACK_BOT_TOKEN=
# Google OAuth 2.0 (Server-side Placeholders)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
