# ==============================================================================
# RiskWise 2.0 Web — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to web/.env.local for local frontend execution.
# ==============================================================================

# Backend API URL (RiskWise backend on port 8000)
# Leave NEXT_PUBLIC_API_URL empty so requests route through Next.js rewrites: /api/v1/* -> :8000
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000

# Google Maps Platform (Live Telemetry & Radar Basemap)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 Client ID (Public client-side credential)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
