# ==============================================================================
# RiskWise 2.0 API — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to api/.env for local backend execution.
# ==============================================================================

# Application & Environment
APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=CHAINSENTINEL
VERSION=1.0.0

# Database Configuration (SQLite local dev default; PostgreSQL in production)
DATABASE_URL=sqlite:///./riskwise_local.db
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/riskwise

# Distributed Cache & Rate Limiter (Valkey / Redis)
REDIS_URL=redis://localhost:6379/0

# AWS Infrastructure (ap-southeast-2)
AWS_REGION=ap-southeast-2

# Google Gemini API Foundation (Primary LLM Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# External Tracking & Telemetry Integrations
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
AISSTREAM_API_KEY=
TAVILY_API_KEY=
PROJECT44_CLIENT_ID=
PROJECT44_CLIENT_SECRET=
MOBILITY_DATABASE_ACCESS_TOKEN=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
KARRIO_API_KEY=
GOOGLE_MAPS_API_KEY=
